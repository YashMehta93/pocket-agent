#!/usr/bin/env node
// pa-service: keep background processes running across Pocket Agent restarts (server/src/services.js).
//   pa-service add <name> [--cwd DIR] -- <command...>   register and start (e.g. a dev or preview server)
//   pa-service list                                     what's registered, running or restarting
//   pa-service logs <name> [lines]                      its recent output
//   pa-service restart|stop|start <name>                stop = keep registered but don't run
//   pa-service remove <name>                            stop and forget it
// Android kills the whole app now and then; registered services start again with Pocket Agent, and
// are restarted (with backoff) if they exit.
const fs = require("fs"), path = require("path");
const argv = process.argv.slice(2), cmd = argv[0];
const usage = () => { console.log(fs.readFileSync(__filename, "utf8").split("\n").slice(1, 9).map(l => l.replace(/^\/\/ ?/, "")).join("\n")); process.exit(cmd ? 2 : 0); };
if (!cmd || cmd === "-h" || cmd === "--help") usage();

let req;
if (cmd === "list") req = { t: "services.list" };
else if (cmd === "add") {
  const dash = argv.indexOf("--");
  const name = argv[1], opts = argv.slice(2, dash < 0 ? argv.length : dash), command = dash < 0 ? "" : argv.slice(dash + 1).join(" ");
  if (!name || !command) usage();
  const ci = opts.indexOf("--cwd");
  req = { t: "services.add", name, cmd: command, cwd: ci >= 0 ? path.resolve(opts[ci + 1]) : process.cwd() };
} else if (cmd === "logs") req = { t: "services.logs", name: argv[1], lines: +(argv[2] || 40) };
else if (cmd === "restart") req = { t: "services.restart", name: argv[1] };
else if (cmd === "stop" || cmd === "start") req = { t: "services.enable", name: argv[1], enabled: cmd === "start" };
else if (cmd === "remove") req = { t: "services.remove", name: argv[1] };
else usage();

const data = process.env.PA_DATA || path.join(process.env.HOME || "/root", ".pocket-agent");
const port = process.env.PA_PORT || "8790";
let token;
try { token = fs.readFileSync(path.join(data, "token"), "utf8").trim(); } catch { console.error("pa-service: Pocket Agent's server token isn't readable here"); process.exit(2); }
let WebSocket;
for (const r of ["/opt/pocket-agent/server", path.resolve(__dirname, "..")]) { try { WebSocket = require(path.join(r, "node_modules/ws")); break; } catch {} }
if (!WebSocket) { console.error("pa-service: can't find the Pocket Agent server"); process.exit(2); }

const ws = new WebSocket(`ws://127.0.0.1:${port}/ws?token=${token}`);
ws.on("error", e => { console.error("pa-service: Pocket Agent's server isn't reachable:", e.message); process.exit(2); });
ws.on("open", () => ws.send(JSON.stringify({ id: 1, ...req })));
ws.on("message", raw => {
  const m = JSON.parse(raw);
  if (m.t !== "reply" || m.id !== 1) return;
  if (m.error) { console.error("pa-service:", m.error); process.exit(1); }
  if (cmd === "list") {
    if (!m.services.length) console.log("No background services. Add one: pa-service add <name> -- <command>");
    for (const s of m.services) {
      const up = s.since ? `up ${Math.round((Date.now() - s.since) / 60000)} min` : "";
      console.log(`${s.name.padEnd(16)} ${(s.enabled ? s.state : "stopped (off)").padEnd(14)} ${[up, s.restarts ? s.restarts + " restarts" : ""].filter(Boolean).join(", ")}`);
      console.log(`  ${s.cmd}   (in ${s.cwd})`);
    }
  } else if (cmd === "logs") process.stdout.write((m.text || "(no output yet)") + "\n");
  else if (cmd === "add") console.log(`${m.service.name}: running. Pocket Agent will keep it running; logs: pa-service logs ${m.service.name}`);
  else console.log("ok");
  process.exit(0);
});
