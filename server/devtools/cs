#!/usr/bin/env node
// cs — every Claude Code session on this device, from every folder.
// Usage: cs            list sessions, then pick a number to open it
//        cs <number>   open that session directly
//        cs -a         show all sessions (default: latest 20)
//        cs -h         help
// Tags:  LIVE  = open in a terminal right now
//        BG:x  = background session (state from `claude agents`)
const fs = require("fs"), path = require("path"), os = require("os");
const { spawnSync } = require("child_process");
const readline = require("readline");

const home = os.homedir();
const base = path.join(home, ".claude");
const args = process.argv.slice(2);
if (args.includes("-h") || args.includes("--help")) {
  console.log(fs.readFileSync(__filename, "utf8").split("\n").slice(1, 9).map(l => l.replace(/^\/\/ ?/, "")).join("\n"));
  process.exit(0);
}
const showAll = args.includes("-a");
const pick = args.find(a => /^\d+$/.test(a));
const readJSON = f => { try { return JSON.parse(fs.readFileSync(f, "utf8")); } catch { return null; } };
const ls = d => { try { return fs.readdirSync(d); } catch { return []; } };

// Sessions currently open in a terminal (registry entries whose pid is alive).
const live = new Map();
for (const f of ls(path.join(base, "sessions"))) {
  if (!f.endsWith(".json")) continue;
  const s = readJSON(path.join(base, "sessions", f));
  if (s && s.sessionId && fs.existsSync(`/proc/${s.pid}`)) live.set(s.sessionId, s);
}
// Background sessions run by the daemon.
const bg = new Map();
for (const d of ls(path.join(base, "jobs"))) {
  const s = readJSON(path.join(base, "jobs", d, "state.json"));
  if (s && s.sessionId) bg.set(s.sessionId, { ...s, short: s.daemonShort || d });
}

const sessions = [];
const root = path.join(base, "projects");
for (const dir of ls(root)) {
  for (const f of ls(path.join(root, dir))) {
    if (!f.endsWith(".jsonl")) continue;
    const id = f.slice(0, -6);
    let cwd = "", first = "", title = "", last = "", msgs = 0;
    let text = "";
    try { text = fs.readFileSync(path.join(root, dir, f), "utf8"); } catch { continue; }
    for (const line of text.split("\n")) {
      if (!line) continue;
      let d; try { d = JSON.parse(line); } catch { continue; }
      if (d.cwd && !cwd) cwd = d.cwd;
      if (d.timestamp) last = d.timestamp;
      if (d.type === "custom-title" && d.customTitle) title = d.customTitle;
      if (d.type === "summary" && d.summary && !title) title = d.summary;
      if (d.type === "user" && !d.isMeta) {
        let c = d.message && d.message.content;
        if (Array.isArray(c)) c = c.map(x => (x && x.type === "text" && x.text) || "").join(" ");
        if (typeof c === "string" && c.trim() && !c.startsWith("<")) {
          msgs++;
          if (!first) first = c.replace(/\s+/g, " ").trim();
        }
      }
    }
    if (!msgs && !bg.has(id)) continue;
    sessions.push({ id, cwd, first, title, last, msgs, live: live.get(id), bg: bg.get(id) });
  }
}
sessions.sort((a, b) => (b.last > a.last ? 1 : -1));
const list = showAll ? sessions : sessions.slice(0, 20);
if (!list.length) { console.log("No sessions found."); process.exit(0); }

const tty = process.stdout.isTTY;
const c = (code, s) => (tty ? `\x1b[${code}m${s}\x1b[0m` : s);
const cols = process.stdout.columns || 80;
function show() {
  list.forEach((s, i) => {
    const when = s.last ? new Date(s.last).toLocaleString([], { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" }) : "?";
    const where = (s.cwd || "?").replace(home, "~");
    const tags = [s.live && c("32", "LIVE"), s.bg && c(s.bg.state === "failed" ? "31" : "33", `BG:${s.bg.state}`)].filter(Boolean).join(" ");
    console.log(`${c("1", String(i + 1).padStart(2))}  ${when}  ${c("36", where)}  (${s.msgs} msgs) ${tags}  ${c("2", s.id.slice(0, 8))}`);
    console.log(`    ${((s.bg && s.bg.name) || s.title || s.first || "(no messages)").slice(0, Math.max(20, cols - 6))}`);
  });
  const hidden = sessions.length - list.length;
  if (hidden > 0) console.log(c("2", `\n…${hidden} older sessions hidden, run cs -a to see all`));
}
function open(n) {
  const s = list[n - 1];
  if (!s) { console.log("No such session."); process.exit(1); }
  const dir = s.cwd && fs.existsSync(s.cwd) ? s.cwd : home;
  if (s.live) { console.log(`Session ${n} is already open in another terminal (pid ${s.live.pid}).`); process.exit(1); }
  const running = s.bg && !["done", "failed", "stopped", "exited"].includes(s.bg.state);
  const argv = running ? ["attach", s.bg.short] : ["--resume", s.id];
  console.log(`${running ? "Attaching to" : "Resuming"} session in ${dir.replace(home, "~")} ...`);
  const r = spawnSync("claude", argv, { cwd: dir, stdio: "inherit" });
  process.exit(r.status ?? 0);
}

if (pick) open(+pick);
show();
if (!process.stdin.isTTY) process.exit(0);
const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
rl.question("\nOpen which # (Enter to quit)? ", a => { rl.close(); if (/^\d+$/.test(a.trim())) open(+a.trim()); });
