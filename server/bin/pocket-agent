#!/data/data/com.termux/files/usr/bin/bash
# pocket-agent — control the Pocket Agent bridge server.
#   pocket-agent start [--token T]   start in the background (no-op if running)
#   pocket-agent stop | restart | status | logs | token
DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
DATA="$HOME/.pocket-agent"
PID="$DATA/server.pid"
LOG="$DATA/server.log"
PORT="${PA_PORT:-8765}"
mkdir -p "$DATA"

running() { [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; }

case "${1:-status}" in
  start)
    shift
    if running; then
      # A new token from the app replaces the old one, so restart to apply it.
      if [ "${1:-}" = "--token" ] && [ "${2:-}" != "$(cat "$DATA/token" 2>/dev/null)" ]; then "$0" stop; else echo "already running (pid $(cat "$PID"))"; exit 0; fi
    fi
    command -v termux-wake-lock >/dev/null && termux-wake-lock
    [ -f "$LOG" ] && [ "$(stat -c %s "$LOG")" -gt 2000000 ] && mv "$LOG" "$LOG.old"
    (cd "$DIR" && exec nohup node src/server.js --port "$PORT" "$@" >>"$LOG" 2>&1 </dev/null) &
    echo $! > "$PID"
    for _ in $(seq 1 30); do curl -fs "http://127.0.0.1:$PORT/health" >/dev/null && { echo "started (pid $(cat "$PID"))"; exit 0; }; sleep 0.2; done
    echo "failed to start, see $LOG"; tail -5 "$LOG"; exit 1 ;;
  stop)
    if running; then kill "$(cat "$PID")"; sleep 0.5; echo stopped; else echo "not running"; fi
    rm -f "$PID"
    command -v termux-wake-unlock >/dev/null && termux-wake-unlock ;;
  restart) shift; "$0" stop; "$0" start "$@" ;;
  status) if running; then echo "running (pid $(cat "$PID"))"; curl -fs "http://127.0.0.1:$PORT/health"; echo; else echo "not running"; fi ;;
  logs) tail -n "${2:-50}" -f "$LOG" ;;
  token) cat "$DATA/token"; echo ;;
  *) sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
