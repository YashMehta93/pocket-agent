{
  "name": "pocket-agent",
  "private": true,
  "description": "Claude Code on your Android phone. See README.md.",
  "scripts": {
    "test": "npm run test:native && npm run test:ui && npm run test:server",
    "test:server": "node server/test/e2e.mjs",
    "test:ui": "node tests/ui/ui.test.mjs && node tests/ui/pair.test.mjs && node tests/ui/setup.test.mjs",
    "test:ui:live": "node tests/ui/ui.test.mjs --live",
    "build:apk": "bash build.sh",
    "dev:server": "PA_PORT=8766 node server/src/index.js --port 8766",
    "test:native": "cd server && node test/native.test.mjs",
    "test:setup": "node tests/ui/setup.test.mjs",
    "test:tar": "bash tests/native/run-tar-test.sh",
    "test:transfer": "bash server/test/transfer.test.sh",
    "test:migrate": "bash server/test/migrate.test.sh",
    "test:github": "bash server/test/github.test.sh"
  },
  "devDependencies": {
    "jsdom": "^25.0.1"
  },
  "license": "MIT"
}
