#!/usr/bin/env bash
# Protects the branches GitHub can't lock on this private repo (docs/RELEASES.md):
#   master        changes only by merging pull requests on GitHub
#   v1.0, v2.0…   frozen stable lines: never change
#   v1.x, v2.x…   release lines: change only by merging pull requests on GitHub
# Feature branches and release tags push normally. Emergency override (owner only):
#   PA_ALLOW_PROTECTED_PUSH=1 git push …
# Enabled per clone with: git config core.hooksPath .githooks   (dev setup does this)
[ "${PA_ALLOW_PROTECTED_PUSH:-}" = 1 ] && exit 0
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/master|refs/heads/main)
      echo "✋ $remote_ref only changes through a merged pull request on GitHub."; status=1 ;;
    refs/heads/v[0-9]*.0)
      echo "✋ ${remote_ref#refs/heads/} is a frozen stable branch; fixes go to the matching .x line."; status=1 ;;
    refs/heads/v[0-9]*.x)
      echo "✋ ${remote_ref#refs/heads/} changes only through merged pull requests. Push a feature branch and open a PR into it."; status=1 ;;
  esac
done
exit $status
